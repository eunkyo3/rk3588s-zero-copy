#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
    # What rkzc-fetch-runtime downloaded: not one of the package's files, so dpkg does not know it.
    rm -f /opt/rkzc/lib/librknnrt.so
    rmdir /opt/rkzc/lib /opt/rkzc 2>/dev/null || true
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
fi
if [ "$1" = purge ]; then
    # The fetched models and their licence text; a model the user put there goes too, as purge means.
    rm -rf /var/lib/rkzc
    rmdir /etc/rkzc 2>/dev/null || true
fi
exit 0
