#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
    # Again, for a removal that did not pass through this version's prerm.
    rm -f /opt/rkzc/lib/librknnrt.so /opt/rkzc/lib/.librknnrt.*
    rmdir /opt/rkzc/lib /opt/rkzc 2>/dev/null || true
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
fi
if [ "$1" = purge ]; then
    # The fetched models and their licence text; a model the user put there goes too, as purge means.
    # Not across a mount: a volume mounted there is the user's.
    rm -rf --one-file-system /var/lib/rkzc 2>/dev/null || true
    rmdir /etc/rkzc 2>/dev/null || true
fi
exit 0
