# rkzc-detect as a service: reads /etc/rkzc/detect.toml, writes JSON lines to the socket named there
# (the example names /run/rkzc/detect.sock; with no output named, the lines go to the journal), and logs
# to the journal.
#   systemctl enable --now rkzc-detect
#   journalctl -u rkzc-detect -f
[Unit]
Description=rkzc-detect: object detection on RTSP streams (RK3588 zero-copy path)
Documentation=https://github.com/eunkyo3/rk3588s-zero-copy
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/rkzc-detect --config /etc/rkzc/detect.toml
# A source that is down is retried inside the program. A restart is for the program's own failure;
# status 2 is a configuration that cannot be used, which a restart does not mend.
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2
# The program stops on SIGTERM and delivers the frames it was inferring first.
TimeoutStopSec=20

# No fixed account: a user made for the run, in the groups the path's devices need on the tested image
# (/dev/dma_heap: video; the NPU's /dev/dri/renderD*: render). A user made for the run also means a
# read-only system outside the directories below. The configuration must be readable by this user:
# by all, or by the group video.
DynamicUser=yes
SupplementaryGroups=video render
# /run/rkzc for the socket; removed when the service stops. A socket under /tmp (private here) or
# under the state directory could not be reached by its readers.
RuntimeDirectory=rkzc
RuntimeDirectoryMode=0755
# The model's default place, readable by the service.
StateDirectory=rkzc

NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
